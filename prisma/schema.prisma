generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

enum MembershipRole {
  TEACHER
  STUDENT
}

enum ContentStatus {
  PUBLISHED
  ARCHIVED
  CANCELLED
}

enum AssignmentProgressStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum MaterialKind {
  FILE
  LINK
}

enum NotificationType {
  ASSIGNMENT_CREATED
  ASSIGNMENT_UPDATED
  ASSIGNMENT_DUE_SOON
  EXAM_CREATED
  EXAM_UPDATED
  MATERIAL_CREATED
  ANNOUNCEMENT_CREATED
  SCHOOL_EVENT_CREATED
  GRADE_ADDED
  GRADE_CHANGED
  ABSENCE_RECORDED
  TERM_CLOSED
}

model School {
  id        String   @id @default(uuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  classes           SchoolClass[]
  subjects          Subject[]
  groups            SubjectGroup[]
  events            SchoolEvent[]
  invitations       Invitation[]
  announcements     Announcement[]
  assignments       Assignment[]
  exams             Exam[]
  materials         Material[]
  auditLogs         AuditLog[]
  terms             Term[]
  grades            GradeEntry[]
  absences          Absence[]
  conductGrades     ConductGrade[]
  homeroomAssignments HomeroomAssignment[]
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  firstName       String
  lastName        String
  role            UserRole
  schoolId        String
  isActive        Boolean   @default(true)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school             School                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  sessions           Session[]
  classMemberships   ClassMembership[]
  taughtGroups       SubjectGroup[]        @relation("GroupTeacher")
  groupMemberships   GroupMembership[]
  announcements      Announcement[]
  assignments        Assignment[]
  assignmentProgress AssignmentProgress[]
  exams              Exam[]
  materials          Material[]
  events             SchoolEvent[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  invitationsCreated Invitation[]          @relation("InvitationCreator")
  emailTokens        EmailToken[]
  loginAttempts      LoginAttempt[]
  gradesGiven        GradeEntry[]          @relation("GradeTeacher")
  gradesReceived     GradeEntry[]          @relation("GradeStudent")
  gradeRevisions     GradeRevision[]
  absences           Absence[]             @relation("AbsenceStudent")
  absencesExcused    Absence[]             @relation("AbsenceExcusedBy")
  absencesRecorded   Absence[]             @relation("AbsenceRecordedBy")
  conductGradesSet   ConductGrade[]        @relation("ConductGradeSetBy")
  conductGrades      ConductGrade[]        @relation("ConductGradeStudent")
  termAverages       TermAverage[]
  homeroomAssignments HomeroomAssignment[]

  @@index([schoolId])
  @@index([role])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id          String           @id @default(uuid())
  email       String
  role        UserRole
  schoolId    String
  classId     String?
  groupId     String?
  tokenHash   String           @unique
  status      InvitationStatus @default(PENDING)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime         @default(now())

  school    School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  createdBy User          @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  class     SchoolClass?  @relation(fields: [classId], references: [id], onDelete: SetNull)
  group     SubjectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([schoolId])
}

model EmailToken {
  id        String         @id @default(uuid())
  userId    String
  type      EmailTokenType
  tokenHash String         @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model LoginAttempt {
  id        String   @id @default(uuid())
  email     String
  ipAddress String
  success   Boolean
  createdAt DateTime @default(now())
  userId    String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model SchoolClass {
  id         String   @id @default(uuid())
  name       String
  schoolId   String
  schoolYear String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school              School             @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  memberships         ClassMembership[]
  groups              SubjectGroup[]
  invitations         Invitation[]
  homeroomAssignments HomeroomAssignment[]

  @@unique([schoolId, name, schoolYear])
  @@index([schoolId])
}

model ClassMembership {
  id        String   @id @default(uuid())
  studentId String
  classId   String
  joinedAt  DateTime @default(now())

  student User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId])
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  schoolId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School         @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  groups SubjectGroup[]

  @@unique([schoolId, name])
}

model SubjectGroup {
  id        String   @id @default(uuid())
  subjectId String
  classId   String
  teacherId String
  schoolId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject        Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  class          SchoolClass       @relation(fields: [classId], references: [id], onDelete: Restrict)
  teacher        User              @relation("GroupTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  school         School            @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  memberships    GroupMembership[]
  announcements  Announcement[]
  assignments    Assignment[]
  exams          Exam[]
  materials      Material[]
  invitations    Invitation[]
  grades         GradeEntry[]
  absences       Absence[]
  termAverages   TermAverage[]

  @@unique([subjectId, classId])
  @@index([schoolId])
  @@index([teacherId])
}

model GroupMembership {
  id             String          @id @default(uuid())
  groupId        String
  userId         String
  membershipRole MembershipRole
  canPost        Boolean         @default(false)
  joinedAt       DateTime        @default(now())

  group SubjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Announcement {
  id        String        @id @default(uuid())
  groupId   String
  schoolId  String
  authorId  String
  title     String
  content   String
  isPinned  Boolean       @default(false)
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  group  SubjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  school School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@index([schoolId])
}

model Assignment {
  id            String        @id @default(uuid())
  groupId       String
  schoolId      String
  authorId      String
  title         String
  description   String
  instructions  String?
  dueAt         DateTime
  status        ContentStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  group    SubjectGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author   User                 @relation(fields: [authorId], references: [id], onDelete: Restrict)
  school   School               @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  progress AssignmentProgress[]

  @@index([groupId, dueAt])
  @@index([schoolId])
}

model AssignmentProgress {
  id           String                    @id @default(uuid())
  assignmentId String
  studentId    String
  status       AssignmentProgressStatus  @default(TODO)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Exam {
  id          String        @id @default(uuid())
  groupId     String
  schoolId    String
  authorId    String
  title       String
  description String
  topic       String?
  scheduledAt DateTime
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  group  SubjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  school School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([groupId, scheduledAt])
  @@index([schoolId])
}

model Material {
  id          String       @id @default(uuid())
  groupId     String
  schoolId    String
  authorId    String
  title       String
  description String?
  kind        MaterialKind
  fileKey     String?
  mimeType    String?
  sizeBytes   Int?
  url         String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  group  SubjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  school School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([groupId])
  @@index([schoolId])
}

model SchoolEvent {
  id          String   @id @default(uuid())
  schoolId    String
  authorId    String
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([schoolId, startsAt])
}

model Notification {
  id           String           @id @default(uuid())
  userId       String
  type         NotificationType
  title        String
  message      String
  resourceType String
  resourceId   String
  dedupeKey    String
  scheduledAt  DateTime?
  sentAt       DateTime?
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String
  schoolId     String
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())

  actor  User   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  school School @relation(fields: [schoolId], references: [id], onDelete: Restrict)

  @@index([schoolId, createdAt])
  @@index([actorId])
}

enum TermStatus {
  OPEN
  CLOSED
}

enum GradeType {
  ORAL
  TEST
  HOMEWORK
  PROJECT
  THESIS
}

enum GradeStatus {
  ACTIVE
  VOIDED
}

enum AbsenceStatus {
  UNEXCUSED
  EXCUSED
}

model Term {
  id         String     @id @default(uuid())
  schoolId   String
  schoolYear String
  number     Int
  startsAt   DateTime
  endsAt     DateTime
  status     TermStatus @default(OPEN)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  school      School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  grades      GradeEntry[]
  absences    Absence[]
  conductGrades ConductGrade[]
  termAverages TermAverage[]

  @@unique([schoolId, schoolYear, number])
  @@index([schoolId])
  @@index([status])
}

model GradeEntry {
  id          String      @id @default(uuid())
  schoolId    String
  termId      String
  groupId     String
  studentId   String
  teacherId   String
  type        GradeType
  value       Int
  gradedAt    DateTime
  comment     String?
  status      GradeStatus @default(ACTIVE)
  voidedReason String?
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  school   School        @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  term     Term          @relation(fields: [termId], references: [id], onDelete: Restrict)
  group    SubjectGroup  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  student  User          @relation("GradeStudent", fields: [studentId], references: [id], onDelete: Restrict)
  teacher  User          @relation("GradeTeacher", fields: [teacherId], references: [id], onDelete: Restrict)
  revisions GradeRevision[]

  @@index([studentId, termId])
  @@index([groupId, termId])
  @@index([schoolId])
}

model GradeRevision {
  id             String   @id @default(uuid())
  gradeId        String
  actorId        String
  previousValue  Int?
  newValue       Int?
  previousStatus GradeStatus?
  newStatus      GradeStatus?
  reason         String
  createdAt      DateTime @default(now())

  grade  GradeEntry @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  actor  User       @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([gradeId])
  @@index([actorId])
}

model Absence {
  id            String        @id @default(uuid())
  schoolId      String
  termId        String
  studentId     String
  groupId       String?
  date          DateTime
  status        AbsenceStatus @default(UNEXCUSED)
  excuseReason  String?
  excusedById   String?
  recordedById  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  term         Term         @relation(fields: [termId], references: [id], onDelete: Restrict)
  student      User         @relation("AbsenceStudent", fields: [studentId], references: [id], onDelete: Restrict)
  group        SubjectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  excusedBy    User?        @relation("AbsenceExcusedBy", fields: [excusedById], references: [id], onDelete: SetNull)
  recordedBy   User         @relation("AbsenceRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([studentId, groupId, date])
  @@index([studentId, date])
  @@index([schoolId])
}

model ConductGrade {
  id        String   @id @default(uuid())
  schoolId  String
  termId    String
  studentId String
  value     Int
  setById   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school  School @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  term    Term   @relation(fields: [termId], references: [id], onDelete: Restrict)
  student User   @relation("ConductGradeStudent", fields: [studentId], references: [id], onDelete: Restrict)
  setBy   User   @relation("ConductGradeSetBy", fields: [setById], references: [id], onDelete: Restrict)

  @@unique([termId, studentId])
  @@index([schoolId])
}

model TermAverage {
  id         String   @id @default(uuid())
  termId     String
  groupId    String
  studentId  String
  average    Float
  thesis     Int?
  computedAt DateTime @default(now())

  term    Term         @relation(fields: [termId], references: [id], onDelete: Cascade)
  group   SubjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([termId, groupId, studentId])
}

model HomeroomAssignment {
  id         String   @id @default(uuid())
  schoolId   String
  classId    String
  teacherId  String
  schoolYear String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  school  School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher User        @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  @@unique([classId, schoolYear])
  @@index([schoolId])
  @@index([teacherId])
}
