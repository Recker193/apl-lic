# Copiază în .env.prod (NU se comite) și completează toate valorile.
# Rulare: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Domeniul public (DNS A/AAAA către server). Pentru test local: localhost
DOMAIN=hssa.liceu.example
# E-mail pentru certificatul Let's Encrypt
ACME_EMAIL=admin@liceu.example

# Generează cu: openssl rand -base64 32
POSTGRES_PASSWORD=
# Generează cu: openssl rand -base64 48
SESSION_SECRET=

# SMTP (invitații, resetare parolă). Portul 465 folosește TLS direct,
# 587 folosește STARTTLS.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_FROM=noreply@liceu.example
MAIL_USER=
MAIL_PASSWORD=

# Opționale
COOKIE_NAME=hssa.sid
SESSION_TTL_HOURS=12
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info

# Backup: retenție în zile, interval în secunde, parolă de criptare (opțională;
# dacă o pierzi, backup-urile criptate nu mai pot fi citite).
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
BACKUP_ENCRYPTION_PASSPHRASE=

# Doar pentru primul administrator (`docker compose ... run --rm backend
# node dist/scripts/bootstrap-admin.js`). Șterge parola după folosire.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_SCHOOL_NAME=
