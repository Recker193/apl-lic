NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://hssa:hssa@localhost:5433/hssa
SESSION_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
COOKIE_NAME=hssa.sid
SESSION_TTL_HOURS=12
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_BYTES=10485760
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@localhost
APP_BASE_URL=http://localhost:3000
ENABLE_CRON=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_SCHOOL_NAME=
BOOTSTRAP_ADMIN_FIRST_NAME=Admin
BOOTSTRAP_ADMIN_LAST_NAME=School

# --- Producție (vezi .env.prod.example și docs/PILOT_RUNBOOK.md) ---
# Număr de proxy-uri de încredere (Caddy = 1); necesar pentru IP real la rate limiting
TRUST_PROXY=false
# Swagger este oprit implicit când NODE_ENV=production
ENABLE_SWAGGER=false
# Nivel de log pino (info, warn, error, debug)
LOG_LEVEL=info
# SMTP autentificat (opțional; Mailhog local nu are nevoie)
MAIL_USER=
MAIL_PASSWORD=
