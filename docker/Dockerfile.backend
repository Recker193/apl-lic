# syntax=docker/dockerfile:1

# ---- build: dependențe complete + compilare TypeScript ----
FROM node:24-bookworm-slim AS build
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci
COPY prisma ./prisma
COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src
RUN npx prisma generate && npm run build
# prune: rămân doar dependențele de producție (prisma CLI e în dependencies,
# necesar pentru `migrate deploy`); clientul Prisma se regenerează după prune.
RUN npm prune --omit=dev && npx prisma generate

# ---- runner: imagine minimă, utilizator non-root ----
FROM node:24-bookworm-slim AS runner
ENV NODE_ENV=production \
    PORT=3000 \
    STORAGE_DIR=/data/uploads
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /data/uploads \
  && chown -R node:node /data /app
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
COPY --from=build --chown=node:node /app/prisma ./prisma
COPY --from=build --chown=node:node /app/package.json ./package.json
USER node
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/v1/health/readiness').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# Migrațiile rulează la pornire; `migrate deploy` este idempotent.
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/main"]
