# Render Environment Variables
# Import this file when setting up your web service

# Server
PORT=3000
NODE_ENV=production

# Database (provided by Render - set this manually)
DATABASE_URL=postgresql://user:password@host:port/database

# Session
SESSION_SECRET=generate-a-random-32-character-string-here

# Cookie Security (Render uses HTTPS)
COOKIE_SECURE=true
COOKIE_NAME=hssa.sid
SESSION_TTL_HOURS=12

# CORS (set to your frontend URL on Vercel)
CORS_ORIGINS=https://your-frontend.vercel.app

# Mail Configuration (use Gmail app-specific password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
# Gmail cere ca expeditorul să fie chiar contul autentificat
MAIL_FROM=your-email@gmail.com

# App
# IMPORTANT: adresa frontend-ului (Vercel), nu a backend-ului: linkurile din
# emailuri (confirmare cont, resetare parolă) trebuie să deschidă interfața web.
APP_BASE_URL=https://your-frontend.vercel.app
STORAGE_DIR=./storage/uploads
MAX_UPLOAD_BYTES=10485760

# Bootstrap Admin (for initial setup - remove after first run)
# BOOTSTRAP_ADMIN_EMAIL=admin@yourdomain.com
# BOOTSTRAP_ADMIN_PASSWORD=834ca27844a3ce892ccb6d7d24b9410e
# BOOTSTRAP_SCHOOL_NAME=Your School Name
